<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.NeuroFlip" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/neuro_void</item>
    </style>

    <!-- Tema usado apenas no arranque, substituído por setTheme() no onCreate -->
    <style name="Theme.NeuroFlip.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/neuro_void</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.NeuroFlip</item>
        <item name="android:statusBarColor" tools:targetApi="l">@android:color/transparent</item>
    </style>

</resources>
