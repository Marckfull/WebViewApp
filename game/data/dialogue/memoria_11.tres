[resource]
script = ExtResource("1")
id = &"memoria_11"
speaker = ""
lines = Array[String](["Uma Memória Perdida vem do outro lado do Silêncio, procurando por ela.", "...Lys, viva, ouvindo a irmã tocar de longe. Ela sorri: sabe que Aria vem.", "Não é só resgate. É um chamado atendido. (11 de 12)"])
