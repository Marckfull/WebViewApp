[resource]
script = ExtResource("1")
id = &"cao_sem_nome_complete"
speaker = "Aldeão"
lines = Array[String](["Você os espantou... e ele voltou. Olha como abana o rabo.", "Não lembro o nome dele, mas lembro do carinho. Isso o Silêncio não levou.", "(Recompensa: Ecos + o Assobio do Lar aponta o santuário mais próximo)"])
