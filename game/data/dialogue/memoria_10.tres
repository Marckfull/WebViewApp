script = ExtResource("1")
id = &"memoria_10"
speaker = ""
lines = Array[String](["Uma Memória Perdida se despede antes mesmo de ser tocada.", "...as Guardiãs, uma a uma, virando eco. Cada adeus mais baixo que o anterior.", "Só Selene ficou — e ficar, para ela, foi calar. (10 de 12)"])
