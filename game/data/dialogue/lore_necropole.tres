[resource]
script = ExtResource("1")
id = &"lore_necropole"
speaker = ""
lines = Array[String](["Uma lápide de sal sem nome — o nome foi comido pelo Silêncio, mas o epitáfio ficou.", "\"A primeira a se calar. Não morreu: sumiu no meio de uma nota que ninguém terminou.\"", "\"Quem a amava ainda espera o fim daquela nota.\""])
