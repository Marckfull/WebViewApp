[gd_resource type="Resource" script_class="DialogueData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/dialogue_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"errante_silencio"
speaker = "Errante"
lines = Array[String](["O Silêncio não é falta de som. É som ao contrário — uma canção que apaga em vez de criar.", "Ele come nomes primeiro. Depois cores. Por último, a lembrança de que aquilo existiu.", "Seu ouvido surdo é imune porque já vive num silêncio próprio. Por isso você ainda escuta o que o mundo esqueceu."])
