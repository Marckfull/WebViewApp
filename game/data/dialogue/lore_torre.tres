lines = Array[String](["Um diário de vigia, aberto na última página, a letra tremendo no fim.", "\"Vi a Guardiã partir. Depois vi a Guardiã fingir que partira. As duas na mesma noite.\"", "\"Não sei qual delas era o adeus.\""])
