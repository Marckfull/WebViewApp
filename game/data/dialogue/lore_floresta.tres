[resource]
script = ExtResource("1")
id = &"lore_floresta"
speaker = ""
lines = Array[String](["Uma inscrição na casca de uma árvore, mais antiga que a floresta parece ser.", "\"Guardiã não escolhe a quem ama. Guardiã só escolhe se conta a ninguém.\"", "Alguém raspou a última linha com raiva — ou com medo."])
