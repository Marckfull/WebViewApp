speaker = ""
lines = Array[String](["A última Memória Perdida pesa como um nome que ninguém pronuncia há séculos.", "...a pessoa que Selene perdeu, dizendo o nome dela — a última coisa que o mundo esqueceu.", "Aria guarda o nome. Agora a Canção pode ser cantada inteira. (12 de 12)"])
