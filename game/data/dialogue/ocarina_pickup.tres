[gd_resource type="Resource" script_class="DialogueData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/dialogue_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"ocarina_pickup"
speaker = "Aria"
lines = Array[String](["Uma ocarina de vidro... fria, e ainda assim vibra.", "Meu ouvido surdo a escuta melhor que o outro. Como se ela lembrasse uma canção que eu nunca aprendi.", "(A Canção do Mundo foi registrada. Toque-a nos Santuários.)"])
