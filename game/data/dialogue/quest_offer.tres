[gd_resource type="Resource" script_class="DialogueData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/dialogue_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"quest_offer"
speaker = "Sobrevivente"
lines = Array[String](["Tem um Ecoado de casca dura rondando por aqui — grande, lento, teimoso.", "Ninguém passa enquanto ele estiver de pé. Se você o derrubar, recompenso em Ecos.", "(Missão aceita: A Casca Teimosa)"])
