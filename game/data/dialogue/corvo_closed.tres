[resource]
script = ExtResource("1")
id = &"corvo_closed"
speaker = "Corvo"
lines = Array[String](["À noite eu não vendo, cartógrafa. Guardo a mercadoria e escuto o Silêncio andar.", "Traz o dia de volta com a tua ocarina, se tiver pressa. A Canção do Crepúsculo vira o mundo.", "Aí eu abro."])
